{
  "bar": {
    "background": "none",
    "id": "ludde.bar",
    "layout": {
      "center": [
        {
          "format": "dddd HH:mm:ss",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "id": "omarchy.clock",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "cities": [
            {
              "name": "Stockholm",
              "zone": "Europe/Stockholm"
            },
            {
              "name": "Delhi",
              "zone": "Asia/Kolkata"
            },
            {
              "name": "Tokyo",
              "zone": "Asia/Tokyo"
            },
            {
              "name": "Los Angeles",
              "zone": "America/Los_Angeles"
            },
            {
              "name": "New York",
              "zone": "America/New_York"
            }
          ],
          "id": "omarchy.elsewhen"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "ludde.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "nosignal.omasend"
        },
        {
          "autoCheckUpdates": true,
          "id": "omaplug"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "tray": []
    },
    "position": "top"
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "nosignal.omasend"
    }
  ],
  "version": 1
}
